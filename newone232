import React, { useState, useEffect, useRef } from 'react';
import { MapPin, Layers, Upload, Eye, EyeOff, Trash2, Download, Settings, ZoomIn, ZoomOut } from 'lucide-react';

const GeoTIFFOverlayApp = () => {
  const [layers, setLayers] = useState([]);
  const [selectedLayer, setSelectedLayer] = useState(null);
  const [baseMap, setBaseMap] = useState('terrain');
  const [mapCenter, setMapCenter] = useState({ lat: 0, lng: 0, zoom: 2 });
  const [showControls, setShowControls] = useState(true);
  const mapRef = useRef(null);
  const leafletMapRef = useRef(null);
  const overlaysRef = useRef({});
  const [leafletLoaded, setLeafletLoaded] = useState(false);

  // Load Leaflet library
  useEffect(() => {
    if (window.L) {
      setLeafletLoaded(true);
      return;
    }

    // Load CSS
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
    document.head.appendChild(link);

    // Load JS
    const script = document.createElement('script');
    script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
    script.async = true;
    script.onload = () => setLeafletLoaded(true);
    document.body.appendChild(script);

    return () => {
      if (script.parentNode) script.parentNode.removeChild(script);
      if (link.parentNode) link.parentNode.removeChild(link);
    };
  }, []);

  // Initialize Leaflet map
  useEffect(() => {
    if (!mapRef.current || leafletMapRef.current || !leafletLoaded || !window.L) return;

    // Create map
    const L = window.L;
    const map = L.map(mapRef.current, {
      center: [mapCenter.lat, mapCenter.lng],
      zoom: mapCenter.zoom,
      zoomControl: false
    });

    // Add base layers
    const baseLayers = {
      terrain: L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
        attribution: 'Tiles © Esri',
        maxZoom: 19
      }),
      street: L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors',
        maxZoom: 19
      }),
      topo: L.tileLayer('https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenTopoMap contributors',
        maxZoom: 17
      })
    };

    baseLayers[baseMap].addTo(map);
    leafletMapRef.current = { map, baseLayers };

    // Update center on map move
    map.on('moveend', () => {
      const center = map.getCenter();
      const zoom = map.getZoom();
      setMapCenter({ lat: center.lat, lng: center.lng, zoom });
    });

    return () => {
      map.remove();
      leafletMapRef.current = null;
    };
  }, [leafletLoaded]);

  // Update base layer when selection changes
  useEffect(() => {
    if (!leafletMapRef.current) return;
    
    const { map, baseLayers } = leafletMapRef.current;
    Object.values(baseLayers).forEach(layer => map.removeLayer(layer));
    baseLayers[baseMap].addTo(map);
  }, [baseMap]);

  // Handle file upload
  const handleFileUpload = async (e) => {
    const files = Array.from(e.target.files);
    
    for (const file of files) {
      if (file.name.toLowerCase().endsWith('.tif') || file.name.toLowerCase().endsWith('.tiff')) {
        // In a real application, you would parse the GeoTIFF here
        // For demo, we'll create a sample overlay
        const newLayer = {
          id: Date.now() + Math.random(),
          name: file.name,
          file: file,
          visible: true,
          opacity: 0.7,
          bounds: [[35.0, -120.0], [45.0, -110.0]], // Example bounds
          type: 'geotiff'
        };
        
        setLayers(prev => [...prev, newLayer]);
        addOverlayToMap(newLayer);
      }
    }
    
    e.target.value = ''; // Reset input
  };

  // Add overlay to map
  const addOverlayToMap = (layer) => {
    if (!leafletMapRef.current) return;
    
    const { map } = leafletMapRef.current;
    const L = window.L;
    
    // Create a colored rectangle as demo (in real app, this would be the actual GeoTIFF)
    const overlay = L.rectangle(layer.bounds, {
      color: `hsl(${Math.random() * 360}, 70%, 50%)`,
      weight: 2,
      fillOpacity: layer.opacity,
      fillColor: `hsl(${Math.random() * 360}, 70%, 50%)`
    }).addTo(map);
    
    overlay.bindPopup(`<b>${layer.name}</b><br>GeoTIFF Overlay`);
    overlaysRef.current[layer.id] = overlay;
    
    // Fit bounds to show the overlay
    map.fitBounds(layer.bounds);
  };

  // Toggle layer visibility
  const toggleLayerVisibility = (layerId) => {
    setLayers(prev => prev.map(layer => {
      if (layer.id === layerId) {
        const newVisibility = !layer.visible;
        const overlay = overlaysRef.current[layerId];
        
        if (overlay && leafletMapRef.current) {
          if (newVisibility) {
            overlay.addTo(leafletMapRef.current.map);
          } else {
            leafletMapRef.current.map.removeLayer(overlay);
          }
        }
        
        return { ...layer, visible: newVisibility };
      }
      return layer;
    }));
  };

  // Update layer opacity
  const updateLayerOpacity = (layerId, opacity) => {
    setLayers(prev => prev.map(layer => {
      if (layer.id === layerId) {
        const overlay = overlaysRef.current[layerId];
        if (overlay) {
          overlay.setStyle({ fillOpacity: opacity });
        }
        return { ...layer, opacity };
      }
      return layer;
    }));
  };

  // Remove layer
  const removeLayer = (layerId) => {
    const overlay = overlaysRef.current[layerId];
    if (overlay && leafletMapRef.current) {
      leafletMapRef.current.map.removeLayer(overlay);
    }
    delete overlaysRef.current[layerId];
    setLayers(prev => prev.filter(layer => layer.id !== layerId));
    if (selectedLayer === layerId) setSelectedLayer(null);
  };

  // Add sample layer
  const addSampleLayer = () => {
    const sampleBounds = [
      [Math.random() * 60 - 30, Math.random() * 120 - 60],
      [Math.random() * 60 - 30 + 10, Math.random() * 120 - 60 + 10]
    ];
    
    const newLayer = {
      id: Date.now(),
      name: `Sample Layer ${layers.length + 1}`,
      visible: true,
      opacity: 0.7,
      bounds: sampleBounds,
      type: 'sample'
    };
    
    setLayers(prev => [...prev, newLayer]);
    addOverlayToMap(newLayer);
  };

  // Zoom controls
  const zoomIn = () => {
    if (leafletMapRef.current) {
      leafletMapRef.current.map.zoomIn();
    }
  };

  const zoomOut = () => {
    if (leafletMapRef.current) {
      leafletMapRef.current.map.zoomOut();
    }
  };

  // Fit to layer bounds
  const fitToLayer = (layerId) => {
    const layer = layers.find(l => l.id === layerId);
    if (layer && leafletMapRef.current) {
      leafletMapRef.current.map.fitBounds(layer.bounds);
    }
  };

  return (
    <div className="flex h-screen bg-gray-900 text-white">
      {/* Sidebar */}
      <div className={`${showControls ? 'w-80' : 'w-0'} transition-all duration-300 bg-gray-800 border-r border-gray-700 overflow-hidden flex flex-col`}>
        {/* Header */}
        <div className="p-4 border-b border-gray-700">
          <h1 className="text-xl font-bold flex items-center gap-2">
            <Layers className="w-6 h-6" />
            GeoTIFF Overlay
          </h1>
          <p className="text-sm text-gray-400 mt-1">Combine & overlay terrain data</p>
        </div>

        {/* Upload Section */}
        <div className="p-4 border-b border-gray-700">
          <label className="flex items-center justify-center gap-2 p-3 bg-blue-600 hover:bg-blue-700 rounded-lg cursor-pointer transition">
            <Upload className="w-5 h-5" />
            <span className="font-medium">Upload GeoTIFF</span>
            <input
              type="file"
              multiple
              accept=".tif,.tiff"
              onChange={handleFileUpload}
              className="hidden"
            />
          </label>
          
          <button
            onClick={addSampleLayer}
            className="w-full mt-2 p-3 bg-green-600 hover:bg-green-700 rounded-lg transition flex items-center justify-center gap-2"
          >
            <MapPin className="w-5 h-5" />
            Add Sample Layer
          </button>
        </div>

        {/* Base Map Selection */}
        <div className="p-4 border-b border-gray-700">
          <label className="block text-sm font-medium mb-2">Base Map</label>
          <select
            value={baseMap}
            onChange={(e) => setBaseMap(e.target.value)}
            className="w-full p-2 bg-gray-700 border border-gray-600 rounded-lg"
          >
            <option value="terrain">Satellite Terrain</option>
            <option value="street">Street Map</option>
            <option value="topo">Topographic</option>
          </select>
        </div>

        {/* Layers List */}
        <div className="flex-1 overflow-y-auto p-4">
          <h2 className="text-sm font-medium mb-3 text-gray-400 uppercase">
            Layers ({layers.length})
          </h2>
          
          {layers.length === 0 ? (
            <div className="text-center py-8 text-gray-500">
              <Layers className="w-12 h-12 mx-auto mb-2 opacity-50" />
              <p className="text-sm">No layers added yet</p>
              <p className="text-xs mt-1">Upload GeoTIFF or add sample</p>
            </div>
          ) : (
            <div className="space-y-2">
              {layers.map((layer) => (
                <div
                  key={layer.id}
                  className={`p-3 rounded-lg border transition ${
                    selectedLayer === layer.id
                      ? 'bg-gray-700 border-blue-500'
                      : 'bg-gray-750 border-gray-600 hover:border-gray-500'
                  }`}
                >
                  {/* Layer Header */}
                  <div className="flex items-center justify-between mb-2">
                    <button
                      onClick={() => setSelectedLayer(selectedLayer === layer.id ? null : layer.id)}
                      className="flex-1 text-left font-medium text-sm truncate"
                    >
                      {layer.name}
                    </button>
                    <div className="flex gap-1">
                      <button
                        onClick={() => toggleLayerVisibility(layer.id)}
                        className="p-1 hover:bg-gray-600 rounded"
                        title={layer.visible ? 'Hide' : 'Show'}
                      >
                        {layer.visible ? (
                          <Eye className="w-4 h-4" />
                        ) : (
                          <EyeOff className="w-4 h-4" />
                        )}
                      </button>
                      <button
                        onClick={() => removeLayer(layer.id)}
                        className="p-1 hover:bg-red-600 rounded"
                        title="Remove"
                      >
                        <Trash2 className="w-4 h-4" />
                      </button>
                    </div>
                  </div>

                  {/* Layer Controls */}
                  {selectedLayer === layer.id && (
                    <div className="space-y-2 pt-2 border-t border-gray-600">
                      <div>
                        <label className="block text-xs text-gray-400 mb-1">
                          Opacity: {Math.round(layer.opacity * 100)}%
                        </label>
                        <input
                          type="range"
                          min="0"
                          max="1"
                          step="0.1"
                          value={layer.opacity}
                          onChange={(e) => updateLayerOpacity(layer.id, parseFloat(e.target.value))}
                          className="w-full"
                        />
                      </div>
                      
                      <button
                        onClick={() => fitToLayer(layer.id)}
                        className="w-full p-2 bg-gray-600 hover:bg-gray-500 rounded text-xs flex items-center justify-center gap-1"
                      >
                        <MapPin className="w-3 h-3" />
                        Zoom to Layer
                      </button>
                      
                      <div className="text-xs text-gray-400">
                        <div>Type: {layer.type}</div>
                        <div>Bounds: [{layer.bounds[0][0].toFixed(2)}, {layer.bounds[0][1].toFixed(2)}]</div>
                      </div>
                    </div>
                  )}
                </div>
              ))}
            </div>
          )}
        </div>

        {/* Info Section */}
        <div className="p-4 border-t border-gray-700 text-xs text-gray-400">
          <div className="flex items-center justify-between">
            <span>Lat: {mapCenter.lat.toFixed(4)}</span>
            <span>Lng: {mapCenter.lng.toFixed(4)}</span>
            <span>Zoom: {mapCenter.zoom}</span>
          </div>
        </div>
      </div>

      {/* Map Container */}
      <div className="flex-1 relative">
        <div ref={mapRef} className="w-full h-full" />
        
        {/* Loading Indicator */}
        {!leafletLoaded && (
          <div className="absolute inset-0 flex items-center justify-center bg-gray-900">
            <div className="text-center">
              <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-500 mx-auto mb-4"></div>
              <p className="text-gray-400">Loading map...</p>
            </div>
          </div>
        )}
        
        {/* Map Controls */}
        <div className="absolute top-4 right-4 flex flex-col gap-2">
          <button
            onClick={() => setShowControls(!showControls)}
            className="p-3 bg-gray-800 hover:bg-gray-700 rounded-lg shadow-lg transition"
            title="Toggle Controls"
          >
            <Settings className="w-5 h-5" />
          </button>
          
          <button
            onClick={zoomIn}
            className="p-3 bg-gray-800 hover:bg-gray-700 rounded-lg shadow-lg transition"
            title="Zoom In"
          >
            <ZoomIn className="w-5 h-5" />
          </button>
          
          <button
            onClick={zoomOut}
            className="p-3 bg-gray-800 hover:bg-gray-700 rounded-lg shadow-lg transition"
            title="Zoom Out"
          >
            <ZoomOut className="w-5 h-5" />
          </button>
        </div>

        {/* Info Overlay */}
        <div className="absolute bottom-4 left-4 bg-gray-800 bg-opacity-90 p-4 rounded-lg shadow-lg max-w-md">
          <h3 className="font-bold mb-2">About This App</h3>
          <p className="text-sm text-gray-300">
            Upload GeoTIFF files to overlay them on real-world terrain. 
            Adjust opacity, toggle visibility, and manage multiple layers.
          </p>
          <p className="text-xs text-gray-400 mt-2">
            Note: This demo uses sample overlays. In production, integrate with 
            GeoTIFF.js or a tile server for actual large TIFF processing.
          </p>
        </div>
      </div>
    </div>
  );
};

export default GeoTIFFOverlayApp;
