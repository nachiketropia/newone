class TIFFProcessor:
    """Handle TIFF file processing operations"""

    @staticmethod
    def get_tiff_info(filepath):
        """Extract metadata from TIFF file"""
        info = {
            "width": None,
            "height": None,
            "bounds": None,
            "crs": None,
            "bands": None,
        }

        if RASTERIO_AVAILABLE:
            try:
                with rasterio.open(filepath) as src:
                    info["width"] = src.width
                    info["height"] = src.height
                    info["bands"] = src.count
                    info["crs"] = str(src.crs) if src.crs else None

                    bounds = src.bounds

                    print(f"Original CRS: {src.crs}")
                    print(f"Original bounds: {bounds}")

                    # Transform bounds to WGS84 when possible and needed
                    if src.crs:
                        try:
                            src_crs = CRS.from_wkt(src.crs.to_wkt()) if hasattr(src.crs, "to_wkt") else CRS.from_string(str(src.crs))
                        except Exception:
                            src_crs = CRS.from_string(str(src.crs))

                        if src_crs != CRS.from_epsg(4326):
                            bounds_wgs84 = transform_bounds(
                                src_crs,
                                CRS.from_epsg(4326),
                                bounds.left,
                                bounds.bottom,
                                bounds.right,
                                bounds.top,
                                densify_pts=21,
                            )
                            info["bounds"] = list(bounds_wgs84)  # [west, south, east, north]
                            print(f"Transformed to WGS84: {info['bounds']}")
                        else:
                            info["bounds"] = [bounds.left, bounds.bottom, bounds.right, bounds.top]
                            print("Using original bounds (already WGS84)")
                    else:
                        # No CRS: we can still return raw bounds, but they may not be geographic
                        info["bounds"] = [bounds.left, bounds.bottom, bounds.right, bounds.top]
                        print("No CRS found; using raw bounds (may not be WGS84)")

                return info
            except Exception as e:
                print(f"Error reading TIFF: {e}")
                import traceback

                traceback.print_exc()

        # Fallback: basic dimensions only
        try:
            with Image.open(filepath) as img:
                info["width"], info["height"] = img.size
        except Exception:
            pass

        return info

    @staticmethod
    def create_preview(filepath, output_path, max_size=2048):
        """Create a PNG preview for displaying in Leaflet."""
        try:
            if not RASTERIO_AVAILABLE:
                raise RuntimeError("Rasterio required for preview generation")

            with rasterio.open(filepath) as src:
                scale = min(max_size / src.width, max_size / src.height, 1.0)
                out_w = max(1, int(src.width * scale))
                out_h = max(1, int(src.height * scale))

                data = src.read(
                    out_shape=(src.count, out_h, out_w),
                    resampling=Resampling.bilinear,
                ).astype("float32")

                if data.shape[0] >= 3:
                    rgb = data[:3]
                else:
                    rgb = np.repeat(data[:1], 3, axis=0)

                for i in range(3):
                    band = rgb[i]
                    band_min, band_max = float(np.min(band)), float(np.max(band))
                    if band_max > band_min:
                        band = (band - band_min) / (band_max - band_min)
                    else:
                        band[:] = 0.0
                    rgb[i] = band

                rgb = np.clip(rgb * 255, 0, 255).astype(np.uint8)
                rgb = np.transpose(rgb, (1, 2, 0))

                alpha = np.full((out_h, out_w), 255, dtype=np.uint8)
                rgba = np.dstack([rgb, alpha])

                img = Image.fromarray(rgba)
                os.makedirs(os.path.dirname(output_path), exist_ok=True)
                img.save(output_path, "PNG")

                print(f"✓ Preview created at {output_path}")
                return True

        except Exception as e:
            print("Preview generation failed")
            print(e)
            import traceback

            traceback.print_exc()
            return False

    @staticmethod
    def merge_tiffs(input_files, output_file):
        """Merge multiple TIFF files"""
        if not RASTERIO_AVAILABLE:
            return False, "rasterio not available"

        src_files = []
        try:
            # Open all rasters
            src_files = [rasterio.open(f) for f in input_files]

            # Merge
            mosaic, out_transform = merge(src_files)

            out_meta = src_files[0].meta.copy()
            out_meta.update(
                {
                    "driver": "GTiff",
                    "height": mosaic.shape[1],
                    "width": mosaic.shape[2],
                    "transform": out_transform,
                    "compress": "lzw",
                }
            )

            with rasterio.open(output_file, "w", **out_meta) as dest:
                dest.write(mosaic)

            return True, "Merge successful"

        except Exception as e:
            return False, str(e)

        finally:
            for src in src_files:
                try:
                    src.close()
                except Exception:
                    pass


@app.after_request
def add_no_cache_headers(resp):
    # Prevent aggressive caching of preview images during uploads/refresh
    resp.headers["Cache-Control"] = "no-store, no-cache, must-revalidate, max-age=0"
    resp.headers["Pragma"] = "no-cache"
    resp.headers["Expires"] = "0"
    return resp


