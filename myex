        function zoomToLayer(layerId) {
            const layer = layers.find(l => l.id === layerId);
            if (layer && layer.bounds) {
                const bounds = L.latLngBounds(
                    [layer.bounds[1], layer.bounds[0]],
                    [layer.bounds[3], layer.bounds[2]]
