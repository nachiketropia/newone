                    <div class="layer-info">
                        Size: ${layer.width} × ${layer.height} px<br>
                        ${layer.crs || 'Unknown CRS'}<br>
                        Bounds: [${layer.bounds ? layer.bounds.map(b => b.toFixed(4)).join(', ') : 'N/A'}]
                    </div>
                </div>
