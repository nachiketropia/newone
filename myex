def _load_layer_registry():
    if not os.path.exists(LAYER_REGISTRY_PATH):
        return {}
    try:
        with open(LAYER_REGISTRY_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)
            return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def _save_layer_registry(registry: dict):
    tmp_path = LAYER_REGISTRY_PATH + ".tmp"
    os.makedirs(os.path.dirname(LAYER_REGISTRY_PATH), exist_ok=True)
    with open(tmp_path, "w", encoding="utf-8") as f:
        json.dump(registry, f, indent=2, ensure_ascii=False)
    os.replace(tmp_path, LAYER_REGISTRY_PATH)


