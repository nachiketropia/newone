@app.route('/upload', methods=['POST'])
def upload_file():
    """Handle file upload"""
    if 'file' not in request.files:
        return jsonify({'success': False, 'error': 'No file provided'})
    
    file = request.files['file']
    if file.filename == '':
        return jsonify({'success': False, 'error': 'No file selected'})
    
    if not file.filename.lower().endswith(('.tif', '.tiff')):
        return jsonify({'success': False, 'error': 'Not a TIFF file'})
    
    try:
        # Save file
        filename = secure_filename(file.filename)
        filepath = os.path.join(app.config['UPLOAD_FOLDER'], filename)
        file.save(filepath)
        
        print(f"\n{'='*70}")
        print(f"Processing uploaded file: {filename}")
        print(f"File path: {filepath}")
        print(f"File size: {os.path.getsize(filepath) / (1024*1024):.2f} MB")
        print(f"{'='*70}")
        
        # Get TIFF info
        info = TIFFProcessor.get_tiff_info(filepath)
        
        if info['width'] is None or info['height'] is None:
            return jsonify({'success': False, 'error': 'Could not read TIFF dimensions'})
        
        print(f"TIFF Info:")
        print(f"  Size: {info['width']} x {info['height']} pixels")
        print(f"  Bands: {info['bands']}")
        print(f"  CRS: {info['crs']}")
        print(f"  Bounds (WGS84): {info['bounds']}")
        
        # Validate bounds
        if not info['bounds'] or len(info['bounds']) != 4:
            return jsonify({'success': False, 'error': 'Could not extract valid geographic bounds from TIFF'})
        
        # Create preview with unique ID
        import time
        layer_id = f"layer_{int(time.time() * 1000)}_{os.getpid()}"
        preview_filename = f"{layer_id}_preview.png"
        preview_path = os.path.join(app.config['OUTPUT_FOLDER'], preview_filename)
        
        print(f"\nCreating preview...")
        print(f"  Preview filename: {preview_filename}")
        print(f"  Preview path: {preview_path}")
        
        preview_created = TIFFProcessor.create_preview(filepath, preview_path)
        
        if not preview_created:
            return jsonify({'success': False, 'error': 'Failed to create preview image. Check server logs for details.'})
        
        # Verify preview file exists and has content
        if not os.path.exists(preview_path):
            return jsonify({'success': False, 'error': f'Preview file was not created at: {preview_path}'})
        
        preview_size = os.path.getsize(preview_path)
        if preview_size == 0:
            return jsonify({'success': False, 'error': 'Preview file is empty'})
        
        print(f"✓ Preview file verified: {preview_size / 1024:.1f} KB")
        
        # Layer data
        layer = {
            'id': layer_id,
            'filename': filename,
            'filepath': filepath,
            'width': info['width'],
            'height': info['height'],
            'bounds': info['bounds'],
            'crs': info['crs'],
            'preview_url': f'/preview/{preview_filename}?t={int(time.time())}'  # Add cache-busting timestamp
        }
        
        print(f"✓ Upload successful!")
        print(f"  Layer ID: {layer_id}")
        print(f"  Preview URL: {layer['preview_url']}")
        print(f"{'='*70}\n")
        
        return jsonify({'success': True, 'layer': layer})
        
    except Exception as e:
        print(f"\n{'!'*70}")
        print(f"ERROR during upload: {e}")
        import traceback
        traceback.print_exc()
        print(f"{'!'*70}\n")
        return jsonify({'success': False, 'error': f'Upload error: {str(e)}'})


@app.route('/merge', methods=['POST'])
def merge_layers():
    """Merge multiple TIFF layers"""
    data = request.get_json()
    layer_ids = data.get('layer_ids', [])
    
    if len(layer_ids) < 2:
        return jsonify({'success': False, 'error': 'Need at least 2 layers'})
    
    try:
        # Find layer files
        input_files = []
        for layer_id in layer_ids:
            # Find matching file
            for f in os.listdir(app.config['UPLOAD_FOLDER']):
                if layer_id in f or f.startswith(layer_id):
                    input_files.append(os.path.join(app.config['UPLOAD_FOLDER'], f))
                    break
        
        if len(input_files) < 2:
            return jsonify({'success': False, 'error': 'Could not find layer files'})
        
        # Merge
        output_file = os.path.join(app.config['OUTPUT_FOLDER'], 'merged_output.tif')
        success, message = TIFFProcessor.merge_tiffs(input_files, output_file)
        
        if success:
            return jsonify({
                'success': True,
                'output_file': output_file,
                'download_url': '/download/merged_output.tif'
            })
        else:
            return jsonify({'success': False, 'error': message})
            
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)})


