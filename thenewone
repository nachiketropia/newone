class TIFFProcessor:
    """Handle TIFF file processing operations"""
    
    @staticmethod
    def get_tiff_info(filepath):
        """Extract metadata from TIFF file"""
        info = {
            'width': None,
            'height': None,
            'bounds': None,
            'crs': None,
            'bands': None
        }
        
        if RASTERIO_AVAILABLE:
            try:
                with rasterio.open(filepath) as src:
                    info['width'] = src.width
                    info['height'] = src.height
                    info['bands'] = src.count
                    info['crs'] = str(src.crs) if src.crs else None
                    
                    # Get bounds and transform to WGS84 (EPSG:4326) for web mapping
                    bounds = src.bounds
                    
                    print(f"Original CRS: {src.crs}")
                    print(f"Original bounds: {bounds}")
                    
                    # Check if we need to transform coordinates
                    if src.crs and src.crs != 'EPSG:4326':
                        from rasterio.warp import transform_bounds
                        # Transform bounds to WGS84
                        bounds_wgs84 = transform_bounds(src.crs, 'EPSG:4326', 
                                                       bounds.left, bounds.bottom, 
                                                       bounds.right, bounds.top)
                        info['bounds'] = list(bounds_wgs84)  # [west, south, east, north]
                        print(f"Transformed to WGS84: {info['bounds']}")
                    else:
                        # Already in WGS84 or no CRS
                        info['bounds'] = [bounds.left, bounds.bottom, bounds.right, bounds.top]
                        print(f"Using original bounds (already WGS84 or no CRS)")
                    
                return info
            except Exception as e:
                print(f"Error reading TIFF: {e}")
                import traceback
                traceback.print_exc()
        
        # Fallback to PIL for basic info
        try:
            with Image.open(filepath) as img:
                info['width'], info['height'] = img.size
        except:
            pass
        
        return info
    
    @staticmethod
    def create_preview(filepath, output_path, max_size=2048):
        """Create a high-quality preview image from TIFF"""
        try:
            print(f"Creating preview for: {filepath}")
            
            # First try with rasterio (best for GeoTIFF)
            if RASTERIO_AVAILABLE:
                try:
                    with rasterio.open(filepath) as src:
                        print(f"TIFF Info - Width: {src.width}, Height: {src.height}, Bands: {src.count}")
                        print(f"Data type: {src.dtypes[0]}, NoData: {src.nodata}")
                        
                        # Calculate optimal size for preview
                        scale = min(max_size / src.width, max_size / src.height, 1.0)
                        out_width = int(src.width * scale)
                        out_height = int(src.height * scale)
                        
                        print(f"Preview size: {out_width}x{out_height} (scale: {scale:.3f})")
                        
                        # Read data with downsampling
                        bands_data = []
                        
                        if src.count >= 3:
                            # RGB - read first 3 bands
                            print("Reading RGB bands...")
                            for i in range(1, 4):
                                band = src.read(
                                    i, 
                                    out_shape=(out_height, out_width), 
                                    resampling=Resampling.bilinear
                                )
                                bands_data.append(band)
                            
                            # Stack into RGB array
                            data = np.stack(bands_data, axis=-1)
                            print(f"RGB data shape: {data.shape}, dtype: {data.dtype}")
                            
                        elif src.count == 1:
                            # Grayscale
                            print("Reading grayscale band...")
                            data = src.read(
                                1, 
                                out_shape=(out_height, out_width), 
                                resampling=Resampling.bilinear
                            )
                            print(f"Grayscale data shape: {data.shape}, dtype: {data.dtype}")
                        else:
                            # Multiple bands but not standard RGB - use first 3 or first band
                            print(f"Reading first 3 bands from {src.count} total bands...")
                            for i in range(1, min(4, src.count + 1)):
                                band = src.read(
                                    i, 
                                    out_shape=(out_height, out_width), 
                                    resampling=Resampling.bilinear
                                )
                                bands_data.append(band)
                            
                            if len(bands_data) >= 3:
                                data = np.stack(bands_data[:3], axis=-1)
                            else:
                                data = bands_data[0]
                        
                        # Handle different data types and normalize to uint8
                        print(f"Data dtype: {data.dtype}, shape: {data.shape}")
                        print(f"Data range before normalization: [{np.min(data)}, {np.max(data)}]")
                        
                        # Handle nodata values first
                        if src.nodata is not None:
                            print(f"Masking nodata values: {src.nodata}")
                            if len(data.shape) == 3:
                                # For RGB
                                for i in range(data.shape[2]):
                                    mask = data[:, :, i] == src.nodata
                                    data[:, :, i] = np.where(mask, 0, data[:, :, i])
                            else:
                                mask = data == src.nodata
                                data = np.where(mask, 0, data)
                        
                        # Normalize to uint8
                        if data.dtype == np.uint8:
                            print("Data already uint8, using as-is")
                            result = data
                        elif data.dtype == np.uint16:
                            print("Converting uint16 to uint8...")
                            # For 16-bit data, scale down
                            result = (data / 256).astype(np.uint8)
                        elif np.issubdtype(data.dtype, np.floating):
                            print("Converting float to uint8...")
                            # For float data, normalize based on actual range
                            if len(data.shape) == 3:
                                result = np.zeros(data.shape, dtype=np.uint8)
                                for i in range(data.shape[2]):
                                    channel = data[:, :, i]
                                    valid = channel[channel != 0]
                                    
                                    if len(valid) > 0:
                                        # Use percentiles for better contrast
                                        vmin, vmax = np.percentile(valid, [2, 98])
                                        if vmax > vmin:
                                            normalized = np.clip((channel - vmin) / (vmax - vmin), 0, 1)
                                            result[:, :, i] = (normalized * 255).astype(np.uint8)
                                        else:
                                            result[:, :, i] = np.clip(channel * 255, 0, 255).astype(np.uint8)
                                    else:
                                        result[:, :, i] = 0
                            else:
                                valid = data[data != 0]
                                if len(valid) > 0:
                                    vmin, vmax = np.percentile(valid, [2, 98])
                                    if vmax > vmin:
                                        normalized = np.clip((data - vmin) / (vmax - vmin), 0, 1)
                                        result = (normalized * 255).astype(np.uint8)
                                    else:
                                        result = np.clip(data * 255, 0, 255).astype(np.uint8)
                                else:
                                    result = np.zeros_like(data, dtype=np.uint8)
                        else:
                            print(f"Converting {data.dtype} to uint8...")
                            # For other integer types
                            if len(data.shape) == 3:
                                result = np.zeros(data.shape, dtype=np.uint8)
                                for i in range(data.shape[2]):
                                    channel = data[:, :, i]
                                    valid = channel[channel != 0]
                                    
                                    if len(valid) > 0:
                                        vmin, vmax = np.percentile(valid, [2, 98])
                                        if vmax > vmin:
                                            normalized = np.clip((channel - vmin) / (vmax - vmin), 0, 1)
                                            result[:, :, i] = (normalized * 255).astype(np.uint8)
                            else:
                                valid = data[data != 0]
                                if len(valid) > 0:
                                    vmin, vmax = np.percentile(valid, [2, 98])
                                    if vmax > vmin:
                                        normalized = np.clip((data - vmin) / (vmax - vmin), 0, 1)
                                        result = (normalized * 255).astype(np.uint8)
                        
                        print(f"Final data shape: {result.shape}, dtype: {result.dtype}")
                        print(f"Final data range: [{np.min(result)}, {np.max(result)}]")
                        
                        # Create PIL image
                        if len(result.shape) == 3:
                            if result.shape[2] == 4:
                                img = Image.fromarray(result, mode='RGBA')
                            elif result.shape[2] == 3:
                                img = Image.fromarray(result, mode='RGB')
                            else:
                                # Single channel stored as 3D array
                                img = Image.fromarray(result[:, :, 0], mode='L').convert('RGB')
                        else:
                            img = Image.fromarray(result, mode='L').convert('RGB')
                        
                        print(f"Created PIL image: {img.size}, mode: {img.mode}")
                        
                except Exception as e:
                    print(f"Rasterio method failed: {e}")
                    import traceback
                    traceback.print_exc()
                    raise
                    
            else:
                # Fallback to PIL only
                print("Rasterio not available, using PIL...")
                img = Image.open(filepath)
                print(f"Opened with PIL: {img.size}, mode: {img.mode}")
                
                # Convert to RGB if needed
                if img.mode not in ('RGB', 'RGBA'):
                    print(f"Converting from {img.mode} to RGB")
                    img = img.convert('RGB')
                
                # Resize if needed
                if img.width > max_size or img.height > max_size:
                    print(f"Resizing from {img.size} to fit {max_size}x{max_size}")
                    img.thumbnail((max_size, max_size), Image.Resampling.LANCZOS)
            
            # Ensure output directory exists
            os.makedirs(os.path.dirname(output_path), exist_ok=True)
            
            # Save with high quality
            print(f"Saving preview to: {output_path}")
            img.save(output_path, 'PNG', quality=95, optimize=False)
            
            # Verify the file was created
            if not os.path.exists(output_path):
                print(f"ERROR: Preview file was not created at {output_path}")
                return False
            
            file_size = os.path.getsize(output_path)
            print(f"✓ Preview created successfully: {output_path}")
            print(f"  Image size: {img.size[0]}x{img.size[1]}, File size: {file_size/1024:.1f} KB")
            
            return True
            
        except Exception as e:
            print(f"ERROR creating preview: {e}")
            import traceback
            traceback.print_exc()
            
            # Try a very simple fallback method with PIL only
            try:
                print("\nAttempting simple PIL fallback method...")
                from PIL import Image
                
                img = Image.open(filepath)
                print(f"Opened image: {img.size}, mode: {img.mode}, format: {img.format}")
                
                # Handle different modes
                if img.mode == 'I' or img.mode == 'I;16':
                    # 16-bit integer, convert to 8-bit
                    print("Converting 16-bit integer to 8-bit")
                    img_array = np.array(img)
                    img_array = (img_array / 256).astype(np.uint8)
                    img = Image.fromarray(img_array)
                elif img.mode == 'F':
                    # 32-bit float, normalize to 8-bit
                    print("Converting 32-bit float to 8-bit")
                    img_array = np.array(img)
                    img_array = np.clip(img_array * 255, 0, 255).astype(np.uint8)
                    img = Image.fromarray(img_array)
                elif img.mode not in ('RGB', 'RGBA', 'L'):
                    print(f"Converting {img.mode} to RGB")
                    img = img.convert('RGB')
                
                # Resize if too large
                if img.width > max_size or img.height > max_size:
                    print(f"Resizing from {img.size}")
                    img.thumbnail((max_size, max_size), Image.Resampling.LANCZOS)
                
                # Ensure RGB
                if img.mode == 'L':
                    img = img.convert('RGB')
                elif img.mode == 'RGBA':
                    # Create white background
                    background = Image.new('RGB', img.size, (255, 255, 255))
                    background.paste(img, mask=img.split()[3])
                    img = background
                
                os.makedirs(os.path.dirname(output_path), exist_ok=True)
                img.save(output_path, 'PNG')
                
                if os.path.exists(output_path):
                    file_size = os.path.getsize(output_path)
                    print(f"✓ Fallback preview created: {output_path} ({file_size/1024:.1f} KB)")
                    return True
                else:
                    print("ERROR: Fallback method did not create file")
                    return False
                    
            except Exception as e2:
                print(f"ERROR in fallback method: {e2}")
                import traceback
                traceback.print_exc()
                return False
    
    @staticmethod
    def merge_tiffs(input_files, output_file):
        """Merge multiple TIFF files"""
        if not RASTERIO_AVAILABLE:
            return False, "rasterio not available"
        
        try:
            # Open all source files
            src_files = [rasterio.open(f) for f in input_files]
            
            # Merge
            mosaic, out_transform = merge(src_files)
            
            # Copy metadata from first file
            out_meta = src_files[0].meta.copy()
            out_meta.update({
                "driver": "GTiff",
                "height": mosaic.shape[1],
                "width": mosaic.shape[2],
                "transform": out_transform,
                "compress": "lzw"
            })
            
            # Write output
            with rasterio.open(output_file, "w", **out_meta) as dest:
                dest.write(mosaic)
            
            # Close sources
            for src in src_files:
                src.close()
            
            return True, "Merge successful"
            
        except Exception as e:
            return False, str(e)


