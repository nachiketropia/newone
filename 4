class CDDataset(Dataset):
    """Simple dataset for change detection"""
    def __init__(self, img1_dir, img2_dir, label_dir, transform=None):
        self.img1_dir = Path(img1_dir)
        self.img2_dir = Path(img2_dir)
        self.label_dir = Path(label_dir)
        
        # Get matching filenames
        self.img_names = sorted([f.name for f in self.img1_dir.glob('*.*')
                                if f.suffix.lower() in ['.png', '.jpg', '.jpeg', '.tif', '.tiff']])
        
        self.transform = transform
        print(f"Found {len(self.img_names)} image pairs")
    
    def __len__(self):
        return len(self.img_names)
    
    def __getitem__(self, idx):
        name = self.img_names[idx]
        
        img1 = Image.open(self.img1_dir / name).convert('RGB')
        img2 = Image.open(self.img2_dir / name).convert('RGB')
        label = Image.open(self.label_dir / name).convert('L')
        
        if self.transform:
            img1 = self.transform(img1)
            img2 = self.transform(img2)
            label = self.transform(label)
        
        # Convert label to binary
        label = (label > 0.5).float()
        
        return img1, img2, label


